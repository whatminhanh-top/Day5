@model List<Day5.Models.ProductViewModel>

<h2>Danh sách sản phẩm</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <!-- Nút thêm mới -->
    <a asp-action="Create" class="btn btn-success">+ Thêm sản phẩm mới</a>

    <!-- Form tìm kiếm -->
    <form asp-action="Index" method="get" class="d-flex" style="max-width: 450px;">
        <div class="input-group">
            <input type="text" name="searchString" value="@ViewBag.CurrentFilter" class="form-control" placeholder="Tìm theo tên SP hoặc danh mục..." />
            <button type="submit" class="btn btn-primary">Tìm</button>
            <a asp-action="Index" class="btn btn-secondary">Xóa lọc</a>
        </div>
    </form>
</div>

<!-- Bảng dữ liệu -->
<table class="table table-bordered table-hover align-middle">
    <thead>
        <tr>
            <th>Mã SP</th>
            <th>Tên sản phẩm</th>
            <th>Danh mục</th>
            <th>Giá bán</th>
            <th style="width: 160px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductId</td>
                <td>@item.ProductName</td>
                <td>@item.CategoryName</td>
                <td>@item.ProductPrice.ToString("N0") đ</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-warning">Sửa</a>

                    <form asp-action="Delete" asp-route-id="@item.ProductId" method="post" class="d-inline"
                          onsubmit="return confirm('Bạn có chắc muốn xóa sản phẩm này không?');">
                        <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Thanh phân trang -->
<nav>
    <ul class="pagination">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@ViewBag.CurrentFilter">@i</a>
            </li>
        }
    </ul>
</nav>