@model List<Day5.Models.ProductViewModel>

<h2>Danh sách sản phẩm</h2>

<!-- Form tìm kiếm -->
<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group" style="max-width: 450px;">
        <input type="text" name="searchString" value="@ViewBag.CurrentFilter" class="form-control" placeholder="Tìm theo tên SP hoặc danh mục..." />
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
        <a asp-action="Index" class="btn btn-secondary">Xóa lọc</a>
    </div>
</form>

<!-- Bảng dữ liệu -->
<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Mã SP</th>
            <th>Tên sản phẩm</th>
            <th>Danh mục</th>
            <th>Giá bán</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductId</td>
                <td>@item.ProductName</td>
                <td>@item.CategoryName</td>
                <td>@item.ProductPrice.ToString("N0") đ</td>
            </tr>
        }
    </tbody>
</table>

<!-- Thanh phân trang -->
<nav>
    <ul class="pagination">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@ViewBag.CurrentFilter">@i</a>
            </li>
        }
    </ul>
</nav>